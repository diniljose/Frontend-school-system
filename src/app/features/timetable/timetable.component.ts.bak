import { Component, inject, OnInit, signal, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { TranslateModule } from '@ngx-translate/core';
import { ApiService } from '../../core/services/api.service';
import { ToastService } from '../../core/services/toast.service';
import { ClassModel } from '../../core/models';

interface Period {
  day: string;
  periodNumber: number;
  periodType: string;
  subject?: string;
  teacher?: string;
  startTime: string;
  endTime: string;
  duration: number;
  room?: string;
}

interface BreakConfig {
  name: string;
  startTime: string;
  endTime: string;
  duration: number;
  days: string[];
}

interface TimingsConfig {
  schoolStartTime: string;
  schoolEndTime: string;
  periodDuration: number;
  breakDuration: number;
  lunchDuration: number;
}

interface TeacherConflict {
  teacher: any;
  day: string;
  time: string;
  existingClass: string;
  existingSection: string;
  subject: string;
}

@Component({
  selector: 'app-timetable',
  standalone: true,
  imports: [CommonModule, FormsModule, TranslateModule],
  template: `
    <div class="page-header">
      <div>
        <h1>📅 {{ 'nav.timetable' | translate }}</h1>
        <p>Create and manage class schedules by section</p>
      </div>
      <div class="header-actions">
        <button class="btn btn-secondary" (click)="exportTimetable()" [disabled]="!selectedClass || !selectedSection">
          📥 Export
        </button>
        <button class="btn btn-primary" (click)="openSettingsModal()">
          ⚙️ Settings
        </button>
      </div>
    </div>

    <div class="card">
      <div class="timetable-toolbar">
        <div class="toolbar-left">
          <div class="filter-group">
            <label>Academic Year</label>
            <select class="form-select" [(ngModel)]="selectedAcademicYear" (change)="loadTimetable()">
              <option value="">Select year</option>
              @for (y of academicYears(); track y._id) { 
                <option [value]="y._id">{{ y.name }}</option> 
              }
            </select>
          </div>
          <div class="filter-group">
            <label>Class</label>
            <select class="form-select" [(ngModel)]="selectedClass" (change)="onClassChange()">
              <option value="">Select a class</option>
              @for (c of classes(); track c._id) { 
                <option [value]="c._id">{{ c.name }} (Grade {{ c.grade }})</option> 
              }
            </select>
          </div>
          <div class="filter-group">
            <label>Section</label>
            <select class="form-select" [(ngModel)]="selectedSection" (change)="loadTimetable()" [disabled]="!selectedClass">
              <option value="">Select section</option>
              @for (s of availableSections(); track s) {
                <option [value]="s">Section {{ s }}</option>
              }
            </select>
          </div>
        </div>
        @if (selectedClass && selectedSection && selectedAcademicYear) {
          <div class="toolbar-right">
            <button class="btn btn-ghost" (click)="clearAll()" title="Clear all slots">🗑️ Clear All</button>
            <button class="btn btn-primary" (click)="saveTimetable()" [disabled]="saving()">
              @if (saving()) { <span class="spinner"></span> }
              💾 Save Timetable
            </button>
          </div>
        }
      </div>

      <!-- Conflict Warnings -->
      @if (conflicts().length > 0) {
        <div class="conflict-banner">
          <span class="conflict-icon">⚠️</span>
          <div class="conflict-text">
            <strong>Teacher Conflicts Detected:</strong>
            <ul>
              @for (c of conflicts(); track c.teacher._id + c.day + c.time) {
                <li>{{ c.teacher.firstName }} {{ c.teacher.lastName }} is assigned to {{ c.subject }} in {{ c.existingClass }} {{ c.existingSection }} on {{ c.day }} at {{ c.time }}</li>
              }
            </ul>
          </div>
        </div>
      }

      @if (selectedClass && selectedSection && selectedAcademicYear) {
        <!-- Working Days Toggle -->
        <div class="working-days-row">
          <label>Working Days:</label>
          <div class="day-toggles">
            @for (day of allDays; track day.value) {
              <label class="day-toggle" [class.active]="workingDays.includes(day.value)">
                <input type="checkbox" [checked]="workingDays.includes(day.value)" (change)="toggleWorkingDay(day.value)" />
                <span>{{ day.label }}</span>
              </label>
            }
          </div>
        </div>

        <div class="timetable-grid" [style.--day-count]="filteredDays().length">
          <div class="tt-header">
            <div class="tt-time-col">Time</div>
            @for (day of filteredDays(); track day.value) { 
              <div class="tt-day-col">{{ day.label }}</div> 
            }
          </div>
          @for (period of generatedPeriods(); track period.periodNumber) {
            <div class="tt-row" [class.break-row]="period.isBreak">
              <div class="tt-time-col">
                <span class="time-label">{{ period.startTime }}</span>
                <span class="time-end">{{ period.endTime }}</span>
                <span class="period-num">P{{ period.periodNumber }}</span>
              </div>
              @for (day of filteredDays(); track day.value) {
                <div class="tt-cell" 
                     [class.break]="period.isBreak" 
                     [class.has-data]="getScheduleEntry(day.value, period.periodNumber)?.subject"
                     [class.conflict]="hasConflict(day.value, period.periodNumber)"
                     (click)="!period.isBreak && editPeriod(day.value, period)">
                  @if (period.isBreak) {
                    <span class="break-label">{{ period.breakName || '☕ Break' }}</span>
                  } @else {
                    @if (getScheduleEntry(day.value, period.periodNumber)?.subject) {
                      <div class="period-content filled">
                        <span class="subject-name">{{ getSubjectName(getScheduleEntry(day.value, period.periodNumber)?.subject) }}</span>
                        <span class="teacher-name">{{ getTeacherName(getScheduleEntry(day.value, period.periodNumber)?.teacher) }}</span>
                        @if (getScheduleEntry(day.value, period.periodNumber)?.room) {
                          <span class="room-name">📍 {{ getScheduleEntry(day.value, period.periodNumber)?.room }}</span>
                        }
                        <button class="delete-slot" (click)="deleteEntry(day.value, period.periodNumber, $event)" title="Clear">✕</button>
                      </div>
                    } @else {
                      <div class="period-content empty">
                        <span class="add-hint">+ Add</span>
                      </div>
                    }
                  }
                </div>
              }
            </div>
          }
        </div>

        <div class="timetable-legend">
          <span class="legend-item"><span class="legend-dot filled"></span> Scheduled</span>
          <span class="legend-item"><span class="legend-dot break"></span> Break</span>
          <span class="legend-item"><span class="legend-dot empty"></span> Free Period</span>
          <span class="legend-item"><span class="legend-dot conflict"></span> Conflict</span>
        </div>
      } @else {
        <div class="empty-state">
          <div class="empty-icon">📅</div>
          <h3>Select Academic Year, Class and Section</h3>
          <p>Choose filters above to view or create the timetable</p>
        </div>
      }
    </div>

    <!-- Edit Period Modal -->
    @if (showEditModal()) {
      <div class="modal-overlay" (click)="closeEditModal()">
        <div class="modal-content" (click)="$event.stopPropagation()">
          <div class="modal-header">
            <h2>{{ editingEntry ? 'Edit' : 'Add' }} Period</h2>
            <button class="close-btn" (click)="closeEditModal()">✕</button>
          </div>
          <div class="modal-body">
            <div class="slot-info">
              <span class="info-badge">{{ editingDay | titlecase }}</span>
              <span class="info-badge">Period {{ editingPeriod?.periodNumber }}</span>
              <span class="info-badge">{{ editingPeriod?.startTime }} - {{ editingPeriod?.endTime }}</span>
            </div>
            
            <div class="form-group">
              <label>Period Type</label>
              <select class="form-select" [(ngModel)]="entryForm.periodType">
                <option value="lecture">Lecture</option>
                <option value="lab">Lab</option>
                <option value="library">Library</option>
                <option value="sports">Sports</option>
                <option value="activity">Activity</option>
                <option value="assembly">Assembly</option>
              </select>
            </div>
            <div class="form-group">
              <label>Subject *</label>
              <select class="form-select" [(ngModel)]="entryForm.subject" (change)="onSubjectChange()">
                <option value="">Select subject</option>
                @for (s of subjects(); track s._id) {
                  <option [value]="s._id">{{ s.name }} ({{ s.code }})</option>
                }
              </select>
            </div>
            <div class="form-group">
              <label>Teacher</label>
              <select class="form-select" [(ngModel)]="entryForm.teacher" (change)="checkTeacherConflict()">
                <option value="">Select teacher</option>
                @for (t of teachers(); track t._id) {
                  <option [value]="t._id">{{ t.firstName }} {{ t.lastName }}</option>
                }
              </select>
              @if (currentConflict) {
                <div class="field-warning">
                  ⚠️ This teacher is already assigned to {{ currentConflict.existingClass }} {{ currentConflict.existingSection }} at this time
                </div>
              }
            </div>
            <div class="form-group">
              <label>Room / Location</label>
              <input type="text" class="form-input" [(ngModel)]="entryForm.room" placeholder="e.g., Room 101, Lab 2" />
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" (click)="closeEditModal()">Cancel</button>
            <button class="btn btn-primary" (click)="saveEntry()" [disabled]="!entryForm.subject">
              Save Period
            </button>
          </div>
        </div>
      </div>
    }

    <!-- Settings Modal -->
    @if (showSettingsModal()) {
      <div class="modal-overlay" (click)="closeSettingsModal()">
        <div class="modal-content modal-lg" (click)="$event.stopPropagation()">
          <div class="modal-header">
            <h2>⚙️ Timetable Settings</h2>
            <button class="close-btn" (click)="closeSettingsModal()">✕</button>
          </div>
          <div class="modal-body">
            <h4>School Timings</h4>
            <div class="settings-grid">
              <div class="form-group">
                <label>School Start Time</label>
                <input type="time" class="form-input" [(ngModel)]="timings.schoolStartTime" />
              </div>
              <div class="form-group">
                <label>School End Time</label>
                <input type="time" class="form-input" [(ngModel)]="timings.schoolEndTime" />
              </div>
              <div class="form-group">
                <label>Period Duration (minutes)</label>
                <input type="number" class="form-input" [(ngModel)]="timings.periodDuration" min="15" max="120" />
              </div>
              <div class="form-group">
                <label>Short Break (minutes)</label>
                <input type="number" class="form-input" [(ngModel)]="timings.breakDuration" min="5" max="30" />
              </div>
              <div class="form-group">
                <label>Lunch Break (minutes)</label>
                <input type="number" class="form-input" [(ngModel)]="timings.lunchDuration" min="15" max="90" />
              </div>
            </div>

            <h4>Breaks Configuration</h4>
            <p class="hint-text">Configure break times. Breaks will appear across all selected working days.</p>
            
            <div class="breaks-list">
              @for (brk of breaks; track brk.name; let i = $index) {
                <div class="break-config-row">
                  <input type="text" class="form-input" [(ngModel)]="brk.name" placeholder="Break name" style="width:150px" />
                  <input type="time" class="form-input" [(ngModel)]="brk.startTime" style="width:120px" />
                  <span>to</span>
                  <input type="time" class="form-input" [(ngModel)]="brk.endTime" style="width:120px" />
                  <input type="number" class="form-input" [(ngModel)]="brk.duration" min="5" placeholder="mins" style="width:80px" />
                  <button class="btn btn-ghost btn-sm" (click)="removeBreak(i)">🗑️</button>
                </div>
              }
            </div>
            <button class="btn btn-secondary btn-sm" (click)="addBreak()">+ Add Break</button>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" (click)="closeSettingsModal()">Cancel</button>
            <button class="btn btn-primary" (click)="applySettings()">Apply Settings</button>
          </div>
        </div>
      </div>
    }
  `,
  styles: [`
    .timetable-toolbar { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--space-4); flex-wrap: wrap; gap: var(--space-3); }
    .toolbar-left { display: flex; gap: var(--space-4); align-items: flex-end; flex-wrap: wrap; }
    .toolbar-right { display: flex; gap: var(--space-2); }
    .filter-group { display: flex; flex-direction: column; gap: var(--space-1); min-width: 150px; }
    .filter-group label { font-size: var(--text-xs); font-weight: 500; color: var(--text-secondary); }

    .conflict-banner { 
      background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); 
      border-radius: var(--radius-md); padding: var(--space-3); margin-bottom: var(--space-4);
      display: flex; gap: var(--space-3);
    }
    .conflict-icon { font-size: 24px; }
    .conflict-text { flex: 1; }
    .conflict-text ul { margin: var(--space-2) 0 0; padding-left: var(--space-4); }
    .conflict-text li { font-size: var(--text-sm); color: #dc2626; }

    .working-days-row { display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4); flex-wrap: wrap; }
    .working-days-row > label { font-weight: 500; font-size: var(--text-sm); }
    .day-toggles { display: flex; gap: var(--space-2); flex-wrap: wrap; }
    .day-toggle { 
      display: flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-3);
      border: 1px solid var(--border-color); border-radius: var(--radius-full); cursor: pointer;
      font-size: var(--text-sm); transition: all 0.15s;
    }
    .day-toggle input { display: none; }
    .day-toggle.active { background: var(--color-primary); color: white; border-color: var(--color-primary); }
    
    .timetable-grid { overflow-x: auto; border: 1px solid var(--border-color); border-radius: var(--radius-lg); }
    .tt-header, .tt-row { display: grid; grid-template-columns: 100px repeat(var(--day-count, 6), 1fr); }
    .tt-header { background: var(--bg-muted); font-weight: 600; font-size: var(--text-sm); border-bottom: 1px solid var(--border-color); }
    .tt-header > div { padding: var(--space-3); text-align: center; border-right: 1px solid var(--border-color); }
    .tt-header > div:last-child { border-right: none; }
    .tt-row { border-bottom: 1px solid var(--border-color); }
    .tt-row:last-child { border-bottom: none; }
    .tt-row.break-row { background: rgba(245,158,11,0.05); }
    
    .tt-time-col { 
      background: var(--bg-muted); font-weight: 600; font-size: var(--text-xs); 
      display: flex; flex-direction: column; align-items: center; justify-content: center; 
      padding: var(--space-2); border-right: 1px solid var(--border-color);
    }
    .time-label { color: var(--text-primary); }
    .time-end { font-size: 10px; color: var(--text-muted); }
    .period-num { font-size: 9px; color: var(--text-muted); margin-top: 2px; }
    .tt-day-col { padding: var(--space-3); }
    
    .tt-cell {
      border-right: 1px solid var(--border-color); padding: var(--space-2);
      min-height: 70px; display: flex; align-items: center; justify-content: center; 
      cursor: pointer; transition: all 0.15s ease; position: relative;
    }
    .tt-cell:last-child { border-right: none; }
    .tt-cell:hover:not(.break) { background: rgba(99, 102, 241, 0.05); }
    .tt-cell.has-data { background: rgba(16, 185, 129, 0.05); }
    .tt-cell.break { background: rgba(245,158,11,0.08); cursor: default; }
    .tt-cell.conflict { background: rgba(239,68,68,0.1); }
    
    .break-label { font-size: var(--text-xs); color: var(--text-muted); font-style: italic; }
    
    .period-content { display: flex; flex-direction: column; align-items: center; gap: 2px; width: 100%; }
    .period-content.filled { position: relative; }
    .period-content.empty { opacity: 0.4; }
    .period-content.empty:hover { opacity: 0.7; }
    .subject-name { font-size: var(--text-sm); font-weight: 600; color: var(--color-primary); text-align: center; }
    .teacher-name { font-size: var(--text-xs); color: var(--text-secondary); text-align: center; }
    .room-name { font-size: 10px; color: var(--text-muted); }
    .add-hint { font-size: var(--text-xs); color: var(--text-muted); }
    
    .delete-slot { 
      position: absolute; top: 2px; right: 2px; width: 18px; height: 18px;
      border: none; background: rgba(239,68,68,0.1); color: #dc2626; 
      border-radius: 50%; cursor: pointer; font-size: 10px; opacity: 0;
      transition: opacity 0.15s;
    }
    .tt-cell:hover .delete-slot { opacity: 1; }
    
    .timetable-legend { display: flex; gap: var(--space-4); justify-content: center; margin-top: var(--space-4); flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--text-secondary); }
    .legend-dot { width: 12px; height: 12px; border-radius: 50%; }
    .legend-dot.filled { background: rgba(16, 185, 129, 0.3); border: 2px solid #10b981; }
    .legend-dot.break { background: rgba(245,158,11,0.3); border: 2px solid #f59e0b; }
    .legend-dot.empty { background: var(--bg-muted); border: 2px solid var(--border-color); }
    .legend-dot.conflict { background: rgba(239,68,68,0.3); border: 2px solid #ef4444; }

    .empty-state { text-align: center; padding: var(--space-8); color: var(--text-muted); }
    .empty-icon { font-size: 48px; margin-bottom: var(--space-3); opacity: 0.5; }
    .empty-state h3 { color: var(--text-primary); margin-bottom: var(--space-2); }
    .empty-state p { margin: 0; }

    /* Modal styles */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: var(--space-4); }
    .modal-content { background: var(--bg-surface); border-radius: var(--radius-xl); max-width: 480px; width: 100%; max-height: 90vh; overflow-y: auto; }
    .modal-content.modal-lg { max-width: 700px; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: var(--space-4) var(--space-6); border-bottom: 1px solid var(--border-color); }
    .modal-header h2 { font-size: var(--text-lg); font-weight: 600; margin: 0; }
    .close-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-muted); }
    .modal-body { padding: var(--space-6); }
    .modal-body h4 { margin: 0 0 var(--space-3); font-size: var(--text-base); }
    .modal-footer { display: flex; justify-content: flex-end; gap: var(--space-3); padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border-color); }

    .slot-info { display: flex; gap: var(--space-2); margin-bottom: var(--space-4); flex-wrap: wrap; }
    .info-badge { background: var(--bg-muted); padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); font-size: var(--text-sm); font-weight: 500; }
    
    .form-group { margin-bottom: var(--space-4); }
    .form-group label { display: block; font-size: var(--text-sm); font-weight: 500; color: var(--text-secondary); margin-bottom: var(--space-1); }
    .field-warning { margin-top: var(--space-2); padding: var(--space-2); background: rgba(245,158,11,0.1); border-radius: var(--radius-sm); font-size: var(--text-xs); color: #d97706; }

    .settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6); }
    .hint-text { font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-4); }
    
    .breaks-list { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-4); max-height: 300px; overflow-y: auto; }
    .break-config-row { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2); background: var(--bg-muted); border-radius: var(--radius-md); flex-wrap: wrap; }

    .spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.6s linear infinite; display: inline-block; margin-right: 6px; }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 768px) {
      .timetable-toolbar { flex-direction: column; align-items: stretch; }
      .toolbar-left, .toolbar-right { width: 100%; justify-content: space-between; }
      .filter-group { min-width: 45%; }
      .settings-grid { grid-template-columns: 1fr 1fr; }
    }
  `]
})
export class TimetableComponent implements OnInit {
  private api = inject(ApiService);
  private toast = inject(ToastService);
  
  loading = signal(false);
  saving = signal(false);
  classes = signal<ClassModel[]>([]);
  subjects = signal<any[]>([]);
  teachers = signal<any[]>([]);
  academicYears = signal<any[]>([]);
  availableSections = signal<string[]>([]);
  conflicts = signal<TeacherConflict[]>([]);
  allTimetables = signal<any[]>([]); // All timetables for conflict checking
  
  selectedClass = '';
  selectedSection = '';
  selectedAcademicYear = '';
  existingTimetableId = '';
  
  schedule: Period[] = [];
  
  showEditModal = signal(false);
  showSettingsModal = signal(false);
  editingEntry: Period | null = null;
  editingPeriod: { periodNumber: number; startTime: string; endTime: string; isBreak?: boolean } | null = null;
  editingDay = '';
  currentConflict: TeacherConflict | null = null;
  
  entryForm = { periodType: 'lecture', subject: '', teacher: '', room: '' };

  allDays = [
    { value: 'monday', label: 'Mon' },
    { value: 'tuesday', label: 'Tue' },
    { value: 'wednesday', label: 'Wed' },
    { value: 'thursday', label: 'Thu' },
    { value: 'friday', label: 'Fri' },
    { value: 'saturday', label: 'Sat' },
    { value: 'sunday', label: 'Sun' },
  ];

  workingDays: string[] = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
  
  timings: TimingsConfig = {
    schoolStartTime: '08:00',
    schoolEndTime: '15:00',
    periodDuration: 45,
    breakDuration: 15,
    lunchDuration: 45,
  };

  breaks: BreakConfig[] = [
    { name: '☕ Short Break', startTime: '09:30', endTime: '09:45', duration: 15, days: [] },
    { name: '🍽️ Lunch Break', startTime: '12:00', endTime: '12:45', duration: 45, days: [] },
  ];

  filteredDays = computed(() => this.allDays.filter(d => this.workingDays.includes(d.value)));

  generatedPeriods = computed(() => {
    const periods: { periodNumber: number; startTime: string; endTime: string; isBreak: boolean; breakName?: string }[] = [];
    let currentTime = this.parseTime(this.timings.schoolStartTime);
    const endTime = this.parseTime(this.timings.schoolEndTime);
    let periodNum = 1;

    while (currentTime < endTime) {
      // Check if this time slot is a break
      const breakAtTime = this.breaks.find(b => {
        const breakStart = this.parseTime(b.startTime);
        return Math.abs(currentTime - breakStart) < 5; // Within 5 minutes
      });

      if (breakAtTime) {
        const breakEnd = this.parseTime(breakAtTime.endTime);
        periods.push({
          periodNumber: periodNum,
          startTime: this.formatTime(currentTime),
          endTime: this.formatTime(breakEnd),
          isBreak: true,
          breakName: breakAtTime.name
        });
        currentTime = breakEnd;
      } else {
        const periodEnd = currentTime + this.timings.periodDuration;
        if (periodEnd <= endTime) {
          periods.push({
            periodNumber: periodNum,
            startTime: this.formatTime(currentTime),
            endTime: this.formatTime(periodEnd),
            isBreak: false
          });
        }
        currentTime = periodEnd;
      }
      periodNum++;
      if (periodNum > 20) break; // Safety limit
    }
    return periods;
  });

  ngOnInit(): void {
    this.loadClasses();
    this.loadSubjects();
    this.loadTeachers();
    this.loadAcademicYears();
    this.loadAllTimetables();
  }

  loadClasses(): void {
    this.api.get<any>('/classes', { limit: 100 }).subscribe({
      next: (res) => {
        const data = res.data?.data || res.data || [];
        this.classes.set(Array.isArray(data) ? data : []);
      }
    });
  }

  loadSubjects(): void {
    this.api.get<any>('/subjects', { limit: 200 }).subscribe({
      next: (res) => {
        const data = res.data?.data || res.data || [];
        this.subjects.set(Array.isArray(data) ? data : []);
      }
    });
  }

  loadTeachers(): void {
    this.api.get<any>('/teachers', { limit: 200, isActive: true }).subscribe({
      next: (res) => {
        const data = res.data?.data || res.data || [];
        this.teachers.set(Array.isArray(data) ? data : []);
      }
    });
  }

  loadAcademicYears(): void {
    this.api.get<any>('/academic-years', { limit: 10 }).subscribe({
      next: (res) => {
        const data = res.data?.data || res.data || [];
        this.academicYears.set(Array.isArray(data) ? data : []);
        // Auto-select current year
        const current = data.find((y: any) => y.isCurrent);
        if (current) this.selectedAcademicYear = current._id;
      }
    });
  }

  loadAllTimetables(): void {
    this.api.get<any>('/timetable', { limit: 500 }).subscribe({
      next: (res) => {
        const data = res.data?.data || res.data || [];
        this.allTimetables.set(Array.isArray(data) ? data : []);
      }
    });
  }

  onClassChange(): void {
    const cls = this.classes().find(c => c._id === this.selectedClass);
    if (cls?.sections?.length) {
      const sections = cls.sections.map((s: any) => typeof s === 'string' ? s : s.name);
      this.availableSections.set(sections);
      if (sections.length === 1) {
        this.selectedSection = sections[0];
        this.loadTimetable();
      } else {
        this.selectedSection = '';
        this.schedule = [];
      }
    } else {
      this.availableSections.set(['A', 'B', 'C', 'D']);
      this.selectedSection = '';
      this.schedule = [];
    }
  }

  loadTimetable(): void {
    if (!this.selectedClass || !this.selectedSection || !this.selectedAcademicYear) return;
    
    this.loading.set(true);
    this.api.get<any>(`/timetable`, { 
      class: this.selectedClass, 
      section: this.selectedSection,
      academicYear: this.selectedAcademicYear
    }).subscribe({
      next: (res) => {
        const data = res.data?.data || res.data || [];
        if (Array.isArray(data) && data.length > 0) {
          const timetable = data[0];
          this.existingTimetableId = timetable._id || '';
          this.schedule = timetable.schedule || [];
          if (timetable.workingDays?.length) {
            this.workingDays = timetable.workingDays;
          }
          if (timetable.timings) {
            this.timings = { ...this.timings, ...timetable.timings };
          }
          if (timetable.breaks?.length) {
            this.breaks = timetable.breaks;
          }
        } else {
          this.schedule = [];
          this.existingTimetableId = '';
        }
        this.checkAllConflicts();
        this.loading.set(false);
      },
      error: () => {
        this.schedule = [];
        this.existingTimetableId = '';
        this.loading.set(false);
      }
    });
  }

  getScheduleEntry(day: string, periodNumber: number): Period | undefined {
    return this.schedule.find(s => s.day === day && s.periodNumber === periodNumber);
  }

  getSubjectName(subjectId: any): string {
    if (!subjectId) return '';
    if (typeof subjectId === 'object') return subjectId.name || subjectId.code || '';
    const sub = this.subjects().find(s => s._id === subjectId);
    return sub?.name || sub?.code || '';
  }

  getTeacherName(teacherId: any): string {
    if (!teacherId) return '';
    if (typeof teacherId === 'object') return `${teacherId.firstName || ''} ${teacherId.lastName || ''}`.trim();
    const t = this.teachers().find(tc => tc._id === teacherId);
    return t ? `${t.firstName || ''} ${t.lastName || ''}`.trim() : '';
  }

  toggleWorkingDay(day: string): void {
    const idx = this.workingDays.indexOf(day);
    if (idx >= 0) {
      this.workingDays.splice(idx, 1);
    } else {
      this.workingDays.push(day);
      this.workingDays.sort((a, b) => {
        const order = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
        return order.indexOf(a) - order.indexOf(b);
      });
    }
  }

  editPeriod(day: string, period: any): void {
    this.editingDay = day;
    this.editingPeriod = period;
    
    const existing = this.getScheduleEntry(day, period.periodNumber);
    if (existing) {
      this.editingEntry = existing;
      this.entryForm = {
        periodType: existing.periodType || 'lecture',
        subject: (existing.subject as any)?._id || existing.subject || '',
        teacher: (existing.teacher as any)?._id || existing.teacher || '',
        room: existing.room || ''
      };
    } else {
      this.editingEntry = null;
      this.entryForm = { periodType: 'lecture', subject: '', teacher: '', room: '' };
    }
    
    this.currentConflict = null;
    this.showEditModal.set(true);
  }

  closeEditModal(): void {
    this.showEditModal.set(false);
    this.editingEntry = null;
    this.editingPeriod = null;
    this.currentConflict = null;
  }

  onSubjectChange(): void {
    // Optionally auto-select teacher who teaches this subject
    const subject = this.subjects().find(s => s._id === this.entryForm.subject);
    if (subject?.teacher) {
      const teacherId = typeof subject.teacher === 'object' ? subject.teacher._id : subject.teacher;
      this.entryForm.teacher = teacherId;
      this.checkTeacherConflict();
    }
  }

  checkTeacherConflict(): void {
    if (!this.entryForm.teacher || !this.editingPeriod || !this.editingDay) {
      this.currentConflict = null;
      return;
    }

    const teacher = this.teachers().find(t => t._id === this.entryForm.teacher);
    if (!teacher) {
      this.currentConflict = null;
      return;
    }

    // Check all other timetables for this teacher at same day/time
    for (const tt of this.allTimetables()) {
      // Skip current class/section
      if (tt.class?._id === this.selectedClass && tt.section === this.selectedSection) continue;
      if (tt.class === this.selectedClass && tt.section === this.selectedSection) continue;

      const conflictEntry = (tt.schedule || []).find((s: any) => {
        const teacherIdInEntry = s.teacher?._id || s.teacher;
        return s.day === this.editingDay && 
               s.periodNumber === this.editingPeriod?.periodNumber &&
               teacherIdInEntry === this.entryForm.teacher;
      });

      if (conflictEntry) {
        const className = tt.class?.name || 'Class';
        this.currentConflict = {
          teacher,
          day: this.editingDay,
          time: this.editingPeriod?.startTime || '',
          existingClass: className,
          existingSection: tt.section,
          subject: this.getSubjectName(conflictEntry.subject)
        };
        return;
      }
    }

    this.currentConflict = null;
  }

  checkAllConflicts(): void {
    const foundConflicts: TeacherConflict[] = [];

    for (const entry of this.schedule) {
      if (!entry.teacher) continue;

      const teacherId = typeof entry.teacher === 'object' ? (entry.teacher as any)._id : entry.teacher;
      const teacher = this.teachers().find(t => t._id === teacherId) || entry.teacher;

      for (const tt of this.allTimetables()) {
        const ttClassId = tt.class?._id || tt.class;
        if (ttClassId === this.selectedClass && tt.section === this.selectedSection) continue;

        const conflictEntry = (tt.schedule || []).find((s: any) => {
          const sTeacherId = s.teacher?._id || s.teacher;
          return s.day === entry.day && s.periodNumber === entry.periodNumber && sTeacherId === teacherId;
        });

        if (conflictEntry) {
          const className = tt.class?.name || 'Class';
          foundConflicts.push({
            teacher: typeof teacher === 'object' ? teacher : { _id: teacherId, firstName: 'Teacher', lastName: '' },
            day: entry.day,
            time: entry.startTime,
            existingClass: className,
            existingSection: tt.section,
            subject: this.getSubjectName(conflictEntry.subject)
          });
        }
      }
    }

    this.conflicts.set(foundConflicts);
  }

  hasConflict(day: string, periodNumber: number): boolean {
    return this.conflicts().some(c => c.day === day && c.time === this.generatedPeriods().find(p => p.periodNumber === periodNumber)?.startTime);
  }

  saveEntry(): void {
    if (!this.entryForm.subject || !this.editingPeriod) return;

    const period = this.generatedPeriods().find(p => p.periodNumber === this.editingPeriod?.periodNumber);
    
    const newEntry: Period = {
      day: this.editingDay,
      periodNumber: this.editingPeriod.periodNumber,
      periodType: this.entryForm.periodType,
      subject: this.entryForm.subject,
      teacher: this.entryForm.teacher || undefined,
      startTime: period?.startTime || '',
      endTime: period?.endTime || '',
      duration: this.timings.periodDuration,
      room: this.entryForm.room || undefined
    };

    // Update or add to schedule
    const existingIdx = this.schedule.findIndex(s => s.day === this.editingDay && s.periodNumber === this.editingPeriod?.periodNumber);
    if (existingIdx >= 0) {
      this.schedule[existingIdx] = newEntry;
    } else {
      this.schedule.push(newEntry);
    }

    this.closeEditModal();
    this.checkAllConflicts();
    this.toast.success('Period added. Click "Save Timetable" to persist changes.');
  }

  deleteEntry(day: string, periodNumber: number, event: Event): void {
    event.stopPropagation();
    this.schedule = this.schedule.filter(s => !(s.day === day && s.periodNumber === periodNumber));
    this.checkAllConflicts();
    this.toast.info('Period removed. Click "Save Timetable" to persist changes.');
  }

  clearAll(): void {
    if (confirm('Clear all periods for this section? This cannot be undone.')) {
      this.schedule = [];
      this.conflicts.set([]);
      this.toast.info('All periods cleared. Click "Save Timetable" to persist changes.');
    }
  }

  saveTimetable(): void {
    if (!this.selectedClass || !this.selectedSection || !this.selectedAcademicYear) return;

    this.saving.set(true);
    
    const payload = {
      academicYear: this.selectedAcademicYear,
      class: this.selectedClass,
      section: this.selectedSection,
      effectiveFrom: new Date().toISOString(),
      workingDays: this.workingDays,
      timings: this.timings,
      breaks: this.breaks.map(b => ({
        name: b.name,
        startTime: b.startTime,
        endTime: b.endTime,
        duration: b.duration,
        days: this.workingDays
      })),
      schedule: this.schedule.map(s => ({
        day: s.day,
        periodNumber: s.periodNumber,
        periodType: s.periodType || 'lecture',
        subject: s.subject,
        teacher: s.teacher,
        startTime: s.startTime,
        endTime: s.endTime,
        duration: s.duration || this.timings.periodDuration,
        room: s.room
      }))
    };

    const saveRequest = this.existingTimetableId 
      ? this.api.put(`/timetable/${this.existingTimetableId}`, payload)
      : this.api.post('/timetable', payload);

    saveRequest.subscribe({
      next: (res: any) => {
        this.existingTimetableId = res.data?._id || this.existingTimetableId;
        this.toast.success('Timetable saved successfully!');
        this.saving.set(false);
        this.loadAllTimetables(); // Refresh for conflict checking
      },
      error: (err) => {
        const msg = err?.error?.message;
        const errorText = Array.isArray(msg) ? msg.join(', ') : (msg || 'Failed to save timetable');
        this.toast.error(errorText);
        this.saving.set(false);
      }
    });
  }

  openSettingsModal(): void {
    this.showSettingsModal.set(true);
  }

  closeSettingsModal(): void {
    this.showSettingsModal.set(false);
  }

  addBreak(): void {
    this.breaks.push({
      name: 'New Break',
      startTime: '10:30',
      endTime: '10:45',
      duration: 15,
      days: []
    });
  }

  removeBreak(index: number): void {
    this.breaks.splice(index, 1);
  }

  applySettings(): void {
    this.closeSettingsModal();
    this.toast.success('Settings applied');
  }

  parseTime(timeStr: string): number {
    const [h, m] = timeStr.split(':').map(Number);
    return h * 60 + m;
  }

  formatTime(minutes: number): string {
    const h = Math.floor(minutes / 60);
    const m = minutes % 60;
    return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}`;
  }

  exportTimetable(): void {
    if (!this.selectedClass || !this.selectedSection) return;
    
    const cls = this.classes().find(c => c._id === this.selectedClass);
    const className = cls?.name || '';
    
    let html = `
      <html><head><title>Timetable - ${className} Section ${this.selectedSection}</title>
      <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        h1 { text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: center; }
        th { background: #f5f5f5; }
        .break { background: #fef3cd; font-style: italic; }
      </style></head><body>
      <h1>📅 Timetable: ${className} - Section ${this.selectedSection}</h1>
      <table>
        <tr><th>Time</th>${this.filteredDays().map(d => `<th>${d.label}</th>`).join('')}</tr>
    `;
    
    this.generatedPeriods().forEach(period => {
      if (period.isBreak) {
        html += `<tr class="break"><td>${period.startTime}-${period.endTime}</td><td colspan="${this.filteredDays().length}">${period.breakName}</td></tr>`;
      } else {
        html += `<tr><td>${period.startTime}-${period.endTime}</td>`;
        this.filteredDays().forEach(day => {
          const entry = this.getScheduleEntry(day.value, period.periodNumber);
          if (entry?.subject) {
            html += `<td><strong>${this.getSubjectName(entry.subject)}</strong><br><small>${this.getTeacherName(entry.teacher)}</small></td>`;
          } else {
            html += `<td>-</td>`;
          }
        });
        html += `</tr>`;
      }
    });
    
    html += `</table></body></html>`;
    
    const printWindow = window.open('', '_blank');
    if (printWindow) {
      printWindow.document.write(html);
      printWindow.document.close();
      printWindow.print();
    }
  }
}
